#!/bin/bash
# Click or keypress dismisses the floating "Done!" terminal.
: 2>/dev/null <>/dev/tty || exit 0

while read -rsn 1 -t 0.1 _ </dev/tty; do :; done

# Enable mouse click reporting so a tap from RustDesk counts as "any key".
printf '\e[?1000h\e[?1002h' >/dev/tty
printf '\n\033[32m● \033[0mDone! Click or press any key to close...' >/dev/tty
read -rsn 1 </dev/tty
printf '\e[?1000l\e[?1002l' >/dev/tty
echo >/dev/tty
