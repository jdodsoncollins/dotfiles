# ─── Theme ─────────────────────────────────────────────────────────
# Run `ghostty +list-themes` and paste the exact name here.
# theme = tokyonight

font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# Wide-gamut / P3 rendering. Revert to srgb if colors look oversaturated.
window-colorspace = display-p3

# ─── Liquid Glass (macOS 26 Tahoe) ─────────────────────────────────
# Blur only applies when opacity < 1.
background-opacity = 0.92
background-blur = macos-glass-regular
background-opacity-cells = false

# ─── Chrome ────────────────────────────────────────────────────────
# Valid: native, transparent, tabs, hidden
macos-titlebar-style = tabs
macos-window-shadow = true
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-save-state = always
resize-overlay = never
cursor-style = block
cursor-style-blink = false

# ─── Mouse (herdr is mouse-native) ─────────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
# false keeps shift+drag as Ghostty-local selection while herdr owns the mouse
mouse-shift-capture = false
link-url = true

# ─── Keys / shell ──────────────────────────────────────────────────
macos-option-as-alt = true
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Start herdr on the first surface only. New tabs, splits, and the quick
# terminal stay plain shells, so closing herdr leaves a working terminal.
# Login shell is what puts ~/.local/bin on PATH for the lookup.
initial-command = /bin/zsh -lc herdr

# Dropdown terminal; needs Privacy → Accessibility permission
quick-terminal-position = top
keybind = global:cmd+grave_accent=toggle_quick_terminal

# BEGIN herdr-agent-usage font
font-codepoint-map = U+E1A0-U+E1B6="Herdr Agent Icons Max"
font-codepoint-map = U+E1C0-U+E1C5="Herdr Agent Icons Max"
# END herdr-agent-usage font

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1B7=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
