+#[test]
+fn mobile_disconnected_agents_stay_behind_more_regardless_of_cached_status() {
+    for status in [
+        AgentStatus::Blocked,
+        AgentStatus::Working,
+        AgentStatus::Done,
+    ] {
+        let mut remote = snapshot();
+        remote.agents.push(ClientShellAgent {
+            pane_id: "pane_stale".into(),
+            workspace_id: "ws_1".into(),
+            tab_id: "tab_1".into(),
+            name: Some("pi".into()),
+            display_agent: None,
+            agent: Some("pi".into()),
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: status,
+            state_change_seq: 1,
+            state_labels: Vec::new(),
+            tokens: Vec::new(),
+            focused: false,
+        });
+        let profile =
+            crate::client::endpoint::SavedSshEndpoint::new("Build", "build", "agents").unwrap();
+        let endpoint_id = ClientEndpointId::Ssh(profile.id.clone());
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        state.set_endpoint_catalog(&[profile]);
+        state.set_snapshot(Box::new(snapshot()));
+        state.set_pane_surface(surface());
+        state.set_endpoint_status(&endpoint_id, ClientEndpointStatus::Online);
+        state.set_endpoint_snapshot(&endpoint_id, Box::new(remote.clone()));
+        remote.revision += 1;
+        remote.agents[0].state_change_seq += 1;
+        state.set_endpoint_snapshot(&endpoint_id, Box::new(remote));
+        state.mode = ClientShellMode::Navigate;
+        for (online, more, visible) in [
+            (true, false, true),
+            (false, false, false),
+            (false, true, true),
+        ] {
+            if !online {
+                state.mark_endpoint_disconnected(&endpoint_id);
+            }
+            state.mobile_show_more = more;
+            let frame = state.compose(44, 40).expect("agent switcher");
+            assert_eq!(state.hits.mobile_targets.iter().any(|(_, target)| {
+                matches!(target, ClientMobileTarget::Agent { pane_id, .. } if pane_id == "pane_stale")
+            }), visible, "{status:?} online={online} more={more}");
+            if !online && !more {
+                assert!(!frame_rows(&frame).join("\n").contains("agents"));
+            }
+        }
+    }
+}
