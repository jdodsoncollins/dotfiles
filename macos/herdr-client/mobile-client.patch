+pub(crate) fn profiles_for_local_machine(
+    profiles: &[SavedSshEndpoint],
+    remote: &crate::config::RemoteConfig,
+    hostname: Option<&str>,
+) -> Vec<SavedSshEndpoint> {
+    profiles
+        .iter()
+        .filter(|profile| {
+            !remote.local_machine_aliases.iter().any(|(host, aliases)| {
+                hostname.is_some_and(|hostname| hostname.eq_ignore_ascii_case(host))
+                    && aliases.iter().any(|alias| {
+                        profile.label.eq_ignore_ascii_case(alias)
+                            || profile.target.eq_ignore_ascii_case(alias)
+                    })
+            })
+        })
+        .cloned()
+        .collect()
+}
