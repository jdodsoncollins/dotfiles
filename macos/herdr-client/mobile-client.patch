+#[test]
+fn mobile_toggle_explorer_requires_advertised_plugin_description_and_uses_opaque_id() {
+    use crate::protocol::{ClientShellCommand, ClientShellCommandAction};
+    for (action, description, available) in [
+        (ClientShellCommandAction::PluginAction, None, false),
+        (
+            ClientShellCommandAction::PluginAction,
+            Some("toggle explorer"),
+            false,
+        ),
+        (
+            ClientShellCommandAction::Shell,
+            Some("Toggle Explorer"),
+            false,
+        ),
+        (
+            ClientShellCommandAction::PluginAction,
+            Some("Toggle Explorer"),
+            true,
+        ),
+    ] {
+        let mut projected = snapshot();
+        projected.commands.push(ClientShellCommand {
+            command_id: "cmd_custom_arbitrary_42".into(),
+            binding_label: "prefix+shift+e".into(),
+            binding_labels: vec!["prefix+shift+e".into()],
+            action,
+            description: description.map(str::to_owned),
+        });
+        let menu = super::super::global_menu::global_menu_items(&projected);
+        let menu_index = menu
+            .iter()
+            .position(|(label, _)| *label == "Toggle Explorer");
+        assert_eq!(menu_index.is_some(), available);
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        state.set_snapshot(Box::new(projected));
+        state.set_pane_surface(surface());
+        state.mode = ClientShellMode::Navigate;
+        state.navigate_workspace_id = state.focused_navigation_target();
+        let frame = state.compose(44, 30).expect("mobile switcher");
+        assert_eq!(
+            frame_rows(&frame).join("\n").contains("Toggle Explorer"),
+            available
+        );
+        let target = state.hits.mobile_targets.iter().find_map(|(rect, target)| {
+            matches!(target, ClientMobileTarget::ToggleExplorer).then_some(*rect)
+        });
+        assert_eq!(target.is_some(), available);
+        let mut outcome = ClientShellInput::default();
+        if let Some(target) = target {
+            outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+                kind: MouseEventKind::Down(MouseButton::Left),
+                column: target.x,
+                row: target.y,
+                modifiers: KeyModifiers::empty(),
+            })]);
+        } else {
+            state.toggle_explorer(&mut outcome);
+            assert!(outcome.actions.is_empty());
+            assert_eq!(state.mode, ClientShellMode::Navigate);
+            continue;
+        }
+        for invocation in 0..2 {
+            let [ClientShellAction::Endpoint {
+                endpoint_id,
+                request,
+                ..
+            }] = outcome.actions.as_slice()
+            else {
+                panic!("expected one endpoint command");
+            };
+            assert!(endpoint_id.is_local());
+            let crate::api::schema::Method::CommandInvoke(params) = &request.method else {
+                panic!("expected command.invoke");
+            };
+            assert_eq!(params.command_id, "cmd_custom_arbitrary_42");
+            assert_eq!(params.workspace_id.as_deref(), Some("ws_1"));
+            assert_eq!(params.tab_id.as_deref(), Some("tab_1"));
+            assert_eq!(params.pane_id.as_deref(), Some("pane_1"));
+            assert_eq!(state.mode, ClientShellMode::Terminal);
+            assert!(state.navigate_workspace_id.is_none());
+            if invocation == 0 {
+                outcome = ClientShellInput::default();
+                state.activate_global_menu_item(menu_index.unwrap(), &mut outcome);
+            }
+        }
+    }
+}
