+#[test]
+fn mobile_collapsed_switcher_selects_tab_in_focused_workspace() {
+    let mut projected = snapshot();
+    let mut second = projected.tabs[0].clone();
+    second.tab_id = "tab_2".into();
+    second.label = "logs".into();
+    second.custom_label = true;
+    second.focused = false;
+    projected.tabs.push(second.clone());
+    second.tab_id = "tab_background".into();
+    second.workspace_id = "ws_other".into();
+    projected.tabs.push(second);
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.mode = ClientShellMode::Navigate;
+    state.compose(44, 20).expect("collapsed tab switcher");
+    assert!(!state.mobile_show_more);
+    assert!(!state.hits.mobile_targets.iter().any(|(_, target)| {
+        matches!(target, ClientMobileTarget::Tab { tab_id, .. } if tab_id == "tab_background")
+    }));
+    let tab = state
+        .hits
+        .mobile_targets
+        .iter()
+        .find_map(|(rect, target)| {
+            matches!(target, ClientMobileTarget::Tab { tab_id, .. } if tab_id == "tab_2")
+                .then_some(*rect)
+        })
+        .expect("second tab");
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: tab.x,
+        row: tab.y,
+        modifiers: KeyModifiers::empty(),
+    })]);
