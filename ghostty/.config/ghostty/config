# ─── Theme ─────────────────────────────────────────────────────────
# Run `ghostty +list-themes` and paste the exact name here.
# theme = tokyonight

font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# Wide-gamut / P3 rendering. Revert to srgb if colors look oversaturated.
window-colorspace = display-p3

# ─── Liquid Glass (macOS 26 Tahoe) ─────────────────────────────────
# Blur only applies when opacity < 1.
background-opacity = 0.92
background-blur = macos-glass-regular
background-opacity-cells = false

# ─── Chrome ────────────────────────────────────────────────────────
# Valid: native, transparent, tabs, hidden
macos-titlebar-style = tabs
macos-window-shadow = true
window-padding-x = 16
window-padding-y = 12,6
window-padding-balance = true
window-save-state = always
resize-overlay = never
cursor-style = block
cursor-style-blink = false

# ─── Mouse (herdr is mouse-native) ─────────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
# false keeps shift+drag as Ghostty-local selection while herdr owns the mouse
mouse-shift-capture = false
link-url = true

# ─── Keys / shell ──────────────────────────────────────────────────
macos-option-as-alt = true
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Dropdown terminal; needs Privacy → Accessibility permission
quick-terminal-position = top
keybind = global:cmd+grave_accent=toggle_quick_terminal